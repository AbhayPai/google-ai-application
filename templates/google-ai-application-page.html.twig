<div class="support-hub">

  <section class="hero">

    <h1>{{ title }}</h1>

    {% if description %}
      <div class="description">
        {{ description }}
      </div>
    {% endif %}

    <div class="support-hub-search">
      {{ search_form }}
    </div>

  </section>

  {% if search_query %}
    <section class="search-results">
      {% if results %}
        {% for result in results %}
          <article class="search-result">
            <h3>{{ result.title }}</h3>

            {% if result.snippet %}
              <div class="snippet">
                {{ result.snippet|raw }}
              </div>
            {% endif %}

          </article>

        {% endfor %}

      {% else %}

        <div class="search-empty">
          No results found.
        </div>

      {% endif %}

    </section>

  {% endif %}

  {% if footer_cards %}
    <section class="footer-cards">

      {% for card in footer_cards %}

        <div class="footer-card">

          <h3>{{ card.field_title }}</h3>

          <div>
            {{ card.field_content }}
          </div>

          {% if card.field_link %}
            <a href="{{ card.field_link }}">
              Learn more
            </a>
          {% endif %}

        </div>

      {% endfor %}

    </section>
  {% endif %}

</div>
