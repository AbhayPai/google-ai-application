<div class="support-hub">

  <section class="hero">

    <h1>{{ title }}</h1>

    {% if description %}
      <div class="description">
        {{ description }}
      </div>
    {% endif %}

    <div class="support-hub-search">
      {{ search_form }}
    </div>

  </section>

  {% if facet_form %}
    <aside class="support-hub-facets">
      {{ facet_form }}
    </aside>
  {% endif %}

  {% if search_query %}

    <section class="search-results">

      {% for result in results %}
        <article class="search-result">
          <h3>{{ result.title }}</h3>

          {% if result.snippet %}
            <div class="snippet">
              {{ result.snippet|raw }}
            </div>
          {% endif %}
        </article>
      {% else %}
        <div class="search-empty">No results found.</div>
      {% endfor %}

    </section>

  {% endif %}

</div>
