<div class="google-ai-application">

  <h2>{{ label }}</h2>

  <table class="table">
    <tbody>
      <tr>
        <th>Project ID</th>
        <td>{{ project_name }}</td>
      </tr>

      <tr>
        <th>Data Store Name</th>
        <td>{{ data_store_name }}</td>
      </tr>

      <tr>
        <th>Schema Name</th>
        <td>{{ schema_name }}</td>
      </tr>

      <tr>
        <th>Location</th>
        <td>{{ location }}</td>
      </tr>

      <tr>
        <th>Branch Name</th>
        <td>{{ branch_name }}</td>
      </tr>

      <tr>
        <th>Serving Config</th>
        <td>{{ serving_config }}</td>
      </tr>

      <tr>
        <th>Content Types</th>
        <td>{{ content_types }}</td>
      </tr>

      <tr>
        <th>Total Nodes</th>
        <td>
          <strong>{{ total_nodes }}</strong>
        </td>
      </tr>

      <tr>
        <th>Nodes Per Content Type</th>
        <td>
          <ul>
            {% for item in content_type_counts %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </td>
      </tr>

    </tbody>
  </table>

</div>
